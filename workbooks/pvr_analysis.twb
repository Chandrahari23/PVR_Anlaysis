      <column caption='Avg Booking Value' datatype='real' name='[Calculation_1929702728765440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Net_Booking_Amount_INR])&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;  IF [Booking_Status] = &quot;Completed&quot;&#13;&#10;  THEN [Booking_ID]&#13;&#10;  END&#13;&#10;)' />
      </column>
      <column caption='Cancellation Rate' datatype='real' name='[Calculation_1929702730043393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;  IIF([Booking_Status] = &quot;Cancelled&quot;, 1, 0)&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Booking_ID])' />
      </column>
      <column caption='Avg Occupancy' datatype='real' name='[Calculation_1929702758572034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Seats_Sold])&#13;&#10;/&#13;&#10;SUM([Seat_Capacity])' />
      </column>
      <column caption='Average Revenue per Screening' datatype='real' name='[Calculation_1929702760366083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Revenue_INR])&#13;&#10;/&#13;&#10;COUNTD([Screening_ID])' />
      </column>
